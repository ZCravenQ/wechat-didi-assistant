# 模型需支持 function/tool calling。地址包含 /v1 时请保留。
LLM_BASE_URL=https://your-provider.example/v1
LLM_API_KEY=replace-me
LLM_MODEL=replace-me
# chat = /chat/completions；responses = /responses
LLM_API_MODE=chat
# 可选：模型厂商参数，例如 {"thinking":{"type":"disabled"}}
LLM_EXTRA_BODY={}

DIDI_MCP_KEY=replace-me
# sandbox：模拟订单；production：微信确认后创建/取消真实订单，支持查单。
DIDI_ENV=sandbox

# 本机管理界面，仅绑定 127.0.0.1；也可用 --ui-port 指定。
ADMIN_PORT=37691
# 可选默认搜索城市，用户对话无须重复提供；管理界面可修改并持久化。
DIDI_DEFAULT_CITY=
# 高德 Web服务 Key，用于官方 MCP 全国地点检索；不是 JavaScript API Key 或滴滴 Key。
# 也可在本地管理界面填写，保存后下一次查询生效；界面设置优先。
AMAP_API_KEY=

# 下面是参照腾讯公开客户端源码的协议版本，可按新版本调整。
WECHAT_CHANNEL_VERSION=2.4.10
